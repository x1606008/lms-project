# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/lms_db"

# Auth
AUTH_SECRET="generate-a-strong-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUSTED_HOST="localhost"

# Cloudinary (optional - without this, avatars save to local public/avatars/)
# Sign up free at https://cloudinary.com - get URL from Dashboard > Settings > API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL="cloudinary://xxx:yyy@zzz"

# Telegram Bot (required for Telegram integration)
# Get token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
# TELEGRAM_BOT_USERNAME="your_lms_bot"
